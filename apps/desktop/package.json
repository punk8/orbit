{
  "name": "@orbit/desktop",
  "private": true,
  "version": "0.0.0",
  "description": "Local-first work context continuity app.",
  "author": "Orbit",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-electron.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "package:dir": "node scripts/package-desktop.mjs dir",
    "package:dmg": "node scripts/package-desktop.mjs dmg",
    "package:smoke": "node scripts/package-smoke.mjs",
    "native:electron": "node scripts/rebuild-native.mjs electron",
    "native:node": "node scripts/rebuild-native.mjs node",
    "rebuild:native:electron": "node scripts/rebuild-native.mjs electron",
    "rebuild:native:node": "node scripts/rebuild-native.mjs node",
    "typecheck": "tsc --noEmit -p ../../tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@orbit/adapters": "workspace:*",
    "@orbit/ai": "workspace:*",
    "@orbit/core": "workspace:*",
    "@orbit/db": "workspace:*",
    "@orbit/ui": "workspace:*",
    "better-sqlite3": "^11.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.12",
    "vite": "^6.1.0"
  }
}
